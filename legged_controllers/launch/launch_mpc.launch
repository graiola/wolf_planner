<?xml version="1.0" ?>

<launch>
    <arg name="robot_name" default="spot" doc="Robot name: [a1, aliengo, go1, laikago]"/>
    <arg name="rviz_gui"   default="false" />

    <!-- Use this node to generate the URDFs -->
    <!-- <node pkg="wolf_description_utils" type="create_urdf_model.sh" name="create_urdf_model" output="screen"
    args="-r $(arg robot_name) -d /tmp/wolf_planner"/> -->

    <!-- make the files into global parameters -->
    <param name="urdfFile" value="$(find legged_controllers)/config/$(arg robot_name)/$(arg robot_name).urdf"/>
    <param name="taskFile" value="$(find legged_controllers)/config/$(arg robot_name)/task.info"/>
    <param name="referenceFile" value="$(find legged_controllers)/config/$(arg robot_name)/reference.info"/>
    <param name="gaitCommandFile" value="$(find legged_controllers)/config/$(arg robot_name)/gait.info"/>

    <node pkg="ocs2_legged_robot_ros" type="legged_robot_gait_command" name="legged_robot_gait_command" output="screen"/>

    <node pkg="legged_controllers" type="wolf_target_trajectories_publisher" name="wolf_robot_target" output="screen"/>

    <node pkg="legged_controllers" type="wolf_mpc_node" name="wolf_mpc_node" output="screen"/>

    <!-- rviz -->
    <node name="wolf_mpc_rviz" pkg="rviz" type="rviz" args="-d $(find legged_controllers)/rviz/mpc.rviz" if="$(arg rviz_gui)"/>

</launch>
