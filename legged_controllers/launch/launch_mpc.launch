<?xml version="1.0" ?>

<launch>
    <arg name="robot_name" default="aliengo" doc="Robot name: [a1, aliengo, go1, laikago]"/>

    <!-- <node pkg="wolf_description_utils" type="create_urdf_model.sh" name="create_urdf_model" output="screen"
    args="-r $(arg robot_name) -d /tmp/wolf_planner"/> -->

    <!-- make the files into global parameters -->
    <param name="urdfFile" value="/tmp/wolf_planner/$(arg robot_name).urdf"/>
    <param name="taskFile" value="$(find legged_controllers)/config/$(arg robot_name)/task.info"/>
    <param name="referenceFile" value="$(find legged_controllers)/config/$(arg robot_name)/reference.info"/>
    <param name="gaitCommandFile" value="$(find legged_controllers)/config/$(arg robot_name)/gait.info"/>

    <node pkg="ocs2_legged_robot_ros" type="legged_robot_gait_command" name="legged_robot_gait_command" output="screen"/>

    <node pkg="legged_controllers" type="legged_target_trajectories_publisher" name="legged_robot_target" output="screen"/>

    <node pkg="legged_controllers" type="ocs2_mpc" name="ocs2_mpc" output="screen"/>

</launch>
